# Copy to .env.development (npm run dev) or .env.production (npm run build).
# Vite inlines every VITE_* value into the shipped bundle, so never put a key
# or a secret in one of these.

# Base URL of bnbu_backend_api. Must end in a slash.
VITE_API_URL=http://localhost:8000/

# development | staging | production. Declared for the deploy environments;
# nothing in the app branches on it.
VITE_ENV=development

# true answers every request from src/demo/fixtures.ts; no backend needed.
VITE_DEMO_MODE=false

# Optional: a proxy you deploy that calls a language model for the Deal Brief.
# Leave empty to use the built-in computed brief.
VITE_AI_PROXY_URL=
VITE_AI_MODEL=claude-sonnet-4-5
